{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
  <div class="row">
    <div class="col-12 col-lg-6 col-xl-5 mb-3 mb-lg-0 order-lg-last align-self-start position-lg-sticky top-lg-3">
      <div class="card">
        <div class="card-header">
        {% if is_trans_auto_edit == true %}
          <h3 class="h4 mb-0">{{ 'page.trans_auto.form.title_edit'|trans }}</h3>
        {% else %}
          <h3 class="h4 mb-0">{{ 'page.trans_auto.form.title'|trans }}</h3>
        {% endif %}
        </div>
        <div class="card-body">
          {{ form_start(form_trans_auto) }}
            {% include 'components/forms/transaction-auto.html.twig' with { is_edit: is_trans_auto_edit } %}

            <div class="mt-2 text-center">
              <button class="btn btn-primary mx-1" type="submit" name="submit">
              {% if is_trans_auto_edit == true %}
                <span class="icon icon-edit"></span>
                Modifier
              {% else %}
                <span class="icon icon-plus-square"></span>
                Ajouter
              {% endif %}
              </button>
            </div>
          {{ form_end(form_trans_auto) }}
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-6 col-xl-7">
    {% if trans_auto is not empty %}
      <div class="card mb-4">
        {#<div class="card-header">
          <h3 class="h4 mb-0">{{ 'page.trans_auto.list.title'|trans }}</h3>
        </div>#}
          <div class="list-with-actions list-transactions -no-scroll py-1">
          {% for ta in trans_auto %}
            {% include 'automaton/_trans-auto-item.html.twig' %}
          {% endfor %}
          </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3 class="h5 mb-0">Totaux des récurrences par période</h3>
        </div>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th class="border-top-0"></th>
                <th class="border-top-0 text-right">/ an</th>
                <th class="border-top-0 text-right">/ mois</th>
                <th class="border-top-0 text-right">/ semaine</th>
                <th class="border-top-0 text-right">/ jour</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Revenus</td>
                {% for total in total_auto_incomes %}
                <td class="text-right text-nowrap">
                  {% include 'components/price.html.twig' with {
                    amount : total,
                    currency : app.user.defaultBankAccount.currency.label } %}
                </td>
                {% endfor %}
              </tr>
              <tr>
                <td>Dépenses</td>
                {% for total in total_auto_expenses %}
                <td class="text-right text-nowrap">
                  {% include 'components/price.html.twig' with {
                    amount : total,
                    currency : app.user.defaultBankAccount.currency.label } %}
                </td>
                {% endfor %}
              </tr>
              <tr>
                <td>Restant</td>
                {% for total in total_auto_benefits %}
                <td class="text-right text-nowrap">
                  {% include 'components/price.html.twig' with {
                    amount : total,
                    currency : app.user.defaultBankAccount.currency.label } %}
                </td>
                {% endfor %}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    {% else %}
      <div class="alert alert-secondary">{{ 'page.trans_auto.list.empty'|trans }}</div>
    {% endif %}
    </div>
  </div>
</div>
{% endblock %}
