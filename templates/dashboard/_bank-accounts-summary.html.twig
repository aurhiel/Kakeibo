<div class="row accordion" id="accordion-bank-accounts-summary">
  {% for ba in bank_accounts %}
    {# @todo: move in controller & with service? BankAccountService? #}
    {% set balanceIncoming = ba|balance('incoming') %}
    {% set balance = ba|balance %}
    {% set incomingTransactions = ba|incoming_transactions %}
    {% set hasBalanceIncoming = balanceIncoming != balance and incomingTransactions is not empty %}
    <div class="col-12 col-md-6 col-lg-4 mb-4">
      <div class="card card-bank-account overflow-hidden">
        <div class="card-body d-flex align-items-center py-3{% if hasBalanceIncoming %} pr-2{% endif %}"{% if hasBalanceIncoming %} id="heading-ba-{{ ba.id }}"
        data-toggle="collapse" data-target="#collapse-ba-{{ ba.id }}" aria-expanded="true" aria-controls="heading-ba-{{ ba.id }}"{% endif %}>
          <div class="col col-text px-0 text-truncate">
            <h5 class="card-title h6 font-weight-bold d-inline">{{ ba.label }}</h5>
            <h6 class="text-muted text-truncate small mb-0">{{ ba.bankBrand.label }}</h6>
          </div>
          <div class="col-auto col-balance d-flex flex-column align-items-end px-0">
            {% include 'components/price.html.twig' with {
              amount : balance,
              currency : ba.currency.label,
              custom_class : 'h6 mb-0 no-wrap' } %}
            {% if hasBalanceIncoming %}
              <small class="-incoming-balance">
                {% include 'components/price.html.twig' with {
                  amount : balanceIncoming,
                  currency : ba.currency.label,
                  custom_class : 'no-wrap' } %}
              </small>
            {% endif %}
          </div>
          {% if hasBalanceIncoming %}
            <div class="col-auto pr-0 pl-1">
              <span class="icon icon-chevron-down px-1"></span>
            </div>
          {% endif %}
        </div>
        {% if hasBalanceIncoming %}
          <div id="collapse-ba-{{ ba.id }}" class="collapse" aria-labelledby="heading-ba-{{ ba.id }}" data-parent="#accordion-bank-accounts-summary">
            {% if incomingTransactions is not empty %}
              <div class="card-footer small font-weight-bold p-2 d-flex align-items-center">
                <span class="col px-0">{{ 'page.dashboard.bank_accounts_summary.upcoming'|trans }}</span>
                <span class="col-auto px-0 icon icon-help-circle text-muted" title="{{ 'page.dashboard.bank_accounts_summary.help_text'|trans({'%date%': '+14days'|date|format_datetime('long', 'none')})|raw }}"
                  data-toggle="tooltip" data-placement="left" data-html="true"></span>
              </div>
              {% set last_date = null %}
              <table class="table table-striped mb-0">
                <tbody>
                {% for ta in incomingTransactions %}
                  <tr>
                    <td class="py-1 pr-0">
                      <span class="-transac-category avatar avatar-xs" title="{{ ta.category.label }}">
                        <span class="avatar-text rounded-circle" style="background-color: {{ ta.category.color }};">
                          <span class="icon icon-{{ ta.category.icon }}"></span>
                        </span>
                      </span>
                    </td>
                    <td class="small py-1 pl-0">
                      {{ ta.label }}
                      {% set dateIncoming = ta.dateNext is defined ? ta.dateNext : ta.date %}
                      <small class="text-muted d-block">{{ dateIncoming|format_datetime('long', 'none') }}</small>
                    </td>
                    <td class="text-right py-1">
                      {% include 'components/price.html.twig' with {
                        amount : ta.amount,
                        currency : ba.currency.label,
                        custom_class : 'small no-wrap' } %}
                    </td>
                  </tr>
                {% endfor %}
                </tbody>
              </table>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
